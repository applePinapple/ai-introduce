{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "完整 AI 与 Agent HTML 演讲",
  "type": "object",
  "required": [
    "title",
    "slides",
    "durationMinutes"
  ],
  "properties": {
    "title": {
      "$ref": "#/$defs/text"
    },
    "styleReference": {
      "type": "object"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "layout",
          "title",
          "section",
          "notes",
          "sourceIds",
          "timingSeconds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/text"
          },
          "layout": {
            "enum": [
              "cover",
              "loop",
              "comparison",
              "spotlight",
              "closing",
              "bullets",
              "duo",
              "table",
              "timeline",
              "process",
              "example",
              "image",
              "diagram"
            ]
          },
          "title": {
            "$ref": "#/$defs/text"
          },
          "section": {
            "$ref": "#/$defs/text"
          },
          "chapter": {
            "$ref": "#/$defs/text"
          },
          "sectionLabel": {
            "$ref": "#/$defs/text"
          },
          "eyebrow": {
            "$ref": "#/$defs/text"
          },
          "subtitle": {
            "type": "string"
          },
          "sourceLabel": {
            "$ref": "#/$defs/text"
          },
          "notes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "sourceIds": {
            "type": "array",
            "minItems": 0,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "brand": {
            "$ref": "#/$defs/text"
          },
          "presenter": {
            "$ref": "#/$defs/text"
          },
          "reportDate": {
            "type": "string",
            "pattern": "^\\d{4}\\.(0[1-9]|1[0-2])$"
          },
          "robotModel": {
            "$ref": "#/$defs/text"
          },
          "logoPath": {
            "type": "string",
            "pattern": "^assets/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
          },
          "logoAlt": {
            "$ref": "#/$defs/text"
          },
          "imagePath": {
            "type": "string",
            "pattern": "^assets/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
          },
          "imageAlt": {
            "$ref": "#/$defs/text"
          },
          "imageCredit": {
            "$ref": "#/$defs/text"
          },
          "inputs": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "$ref": "#/$defs/step"
            }
          },
          "outputs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/step"
            }
          },
          "model": {
            "$ref": "#/$defs/text"
          },
          "modelCaption": {
            "$ref": "#/$defs/text"
          },
          "feedback": {
            "$ref": "#/$defs/text"
          },
          "condition": {
            "$ref": "#/$defs/text"
          },
          "exampleLabel": {
            "$ref": "#/$defs/text"
          },
          "example": {
            "$ref": "#/$defs/text"
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "required": [
                "label",
                "text"
              ],
              "properties": {
                "label": {
                  "$ref": "#/$defs/text"
                },
                "text": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          },
          "headers": {
            "type": "array",
            "minItems": 2,
            "maxItems": 5,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 5,
              "items": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "takeaways": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "title",
                "text",
                "tone"
              ],
              "properties": {
                "title": {
                  "$ref": "#/$defs/text"
                },
                "text": {
                  "$ref": "#/$defs/text"
                },
                "tone": {
                  "$ref": "#/$defs/tone"
                }
              }
            }
          },
          "timingSeconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 600
          },
          "contentKind": {
            "const": "presentation-plan"
          },
          "evidencePaths": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^assets/(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:]+$"
            }
          },
          "lead": {
            "$ref": "#/$defs/text"
          },
          "takeaway": {
            "$ref": "#/$defs/text"
          },
          "footnote": {
            "$ref": "#/$defs/text"
          },
          "prompt": {
            "$ref": "#/$defs/text"
          },
          "response": {
            "$ref": "#/$defs/text"
          },
          "caption": {
            "$ref": "#/$defs/text"
          },
          "promptLabel": {
            "$ref": "#/$defs/text"
          },
          "responseLabel": {
            "$ref": "#/$defs/text"
          },
          "bullets": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "columns": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "required": [
                "title",
                "bullets"
              ],
              "properties": {
                "title": {
                  "$ref": "#/$defs/text"
                },
                "bullets": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 4,
                  "items": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            }
          },
          "items": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "label",
                "description"
              ],
              "properties": {
                "label": {
                  "$ref": "#/$defs/text"
                },
                "description": {
                  "$ref": "#/$defs/text"
                }
              }
            }
          },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "maxItems": 4,
            "items": {
              "type": "object",
              "required": [
                "label",
                "description",
                "tone"
              ],
              "properties": {
                "label": {
                  "$ref": "#/$defs/text"
                },
                "description": {
                  "$ref": "#/$defs/text"
                },
                "tone": {
                  "$ref": "#/$defs/tone"
                }
              }
            }
          },
          "diagramKind": {
            "enum": [
              "pipeline",
              "network"
            ]
          }
        },
        "dependentRequired": {
          "presenter": ["reportDate"],
          "reportDate": ["presenter"]
        },
        "allOf": [
          {
            "if": {
              "anyOf": [
                { "required": ["presenter"] },
                { "required": ["reportDate"] },
                { "required": ["robotModel"] }
              ]
            },
            "then": {
              "properties": { "layout": { "const": "cover" } }
            }
          },
          {
            "if": {
              "required": ["logoPath"]
            },
            "then": {
              "required": ["logoAlt"]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "cover"
                }
              }
            },
            "then": {
              "required": [
                "eyebrow",
                "subtitle",
                "brand",
                "imagePath",
                "imageAlt",
                "imageCredit"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "enum": [
                    "loop",
                    "comparison"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "chapter",
                "sectionLabel",
                "eyebrow",
                "subtitle",
                "sourceLabel"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "loop"
                }
              }
            },
            "then": {
              "required": [
                "inputs",
                "outputs",
                "model",
                "modelCaption",
                "feedback",
                "condition"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "comparison"
                }
              }
            },
            "then": {
              "required": [
                "exampleLabel",
                "example",
                "steps",
                "headers",
                "rows",
                "takeaways"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "spotlight"
                }
              }
            },
            "then": {
              "required": [
                "lead",
                "bullets"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "closing"
                }
              }
            },
            "then": {
              "required": [
                "bullets"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "bullets"
                }
              }
            },
            "then": {
              "required": [
                "bullets"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "duo"
                }
              }
            },
            "then": {
              "required": [
                "columns"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "table"
                }
              }
            },
            "then": {
              "required": [
                "headers",
                "rows"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "timeline"
                }
              }
            },
            "then": {
              "required": [
                "items"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "process"
                }
              }
            },
            "then": {
              "required": [
                "items"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "example"
                }
              }
            },
            "then": {
              "required": [
                "prompt",
                "response",
                "promptLabel",
                "responseLabel"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "image"
                }
              }
            },
            "then": {
              "required": [
                "imagePath",
                "caption"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "layout": {
                  "const": "diagram"
                }
              }
            },
            "then": {
              "required": [
                "diagramKind",
                "nodes"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "sourceIds": {
                  "maxItems": 0
                }
              }
            },
            "then": {
              "required": [
                "contentKind"
              ]
            }
          }
        ]
      }
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "tone": {
      "enum": [
        "blue",
        "orange",
        "green"
      ]
    },
    "step": {
      "type": "object",
      "required": [
        "label",
        "text",
        "tone"
      ],
      "properties": {
        "label": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "tone": {
          "$ref": "#/$defs/tone"
        }
      }
    },
    "threeCells": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  }
}
